# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# ---- generated / reproducible artifacts (NOT version-controlled) ----
# All of these are regenerated by the scripts; keeping them out keeps the repo lean.
test_results/
train_log/
*.npy
*.pth
*.log

# data: publish ONLY the BCA-grounded PPVC benchmark instances (the paper-promised
# "instance seeds"); keep DANIEL base benchmarks (SD1/SD2/BenchData) out.
data/*
!data/PPVC/

# or_solution: publish ONLY the PPVC CP-SAT references (.jsonl + *_summary.json,
# the paper-promised "CP-SAT references"); solver logs and the
# DANIEL base solutions (BenchData/SD1/SD2) stay out.
or_solution/*
!or_solution/PPVC/
or_solution/PPVC/*.log

# trained_network: publish ONLY the PPVC paper checkpoints (exclude smoke/scratch
# and the DANIEL base models SD1/SD2). Tiny (~150KB each); lets readers reproduce
# the learned-policy numbers without a GPU.
trained_network/*
!trained_network/PPVC/
!trained_network/PPVC/*.pth
trained_network/PPVC/*smoke*

# ---- local scratch / backups ----
_interrupted_run_backup/
.auto-git-sync.log

# ---- LaTeX build output ----
IEEE Paper/draft/build/
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz

# ---- OS / editor ----
.DS_Store
*.swp
.vscode/

# ---- not distributed ----
IEEE Paper/
experiments/
train_time.txt
