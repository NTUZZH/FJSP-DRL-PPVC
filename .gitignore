# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/

# ---- generated artifacts ----
# Training logs, numpy arrays, checkpoints and solver logs are not tracked by
# default; the files that the paper's tables are computed from are re-included
# at the end of this file.
test_results/*
train_log/*
*.npy
*.pth
*.log

# data: the PPVC benchmark instances (test sets) and the two validation sets
# of the released policy; DANIEL base benchmarks (SD1/SD2/BenchData) stay out.
data/*
!data/PPVC/
!data/data_train_vali/
data/data_train_vali/*
!data/data_train_vali/PPVC/
data/data_train_vali/PPVC/*
!data/data_train_vali/PPVC/10x25+ppvc-mixed-lagx0.5/
!data/data_train_vali/PPVC/20x25+ppvc-mixed-lagx0.5/

# or_solution: the PPVC CP-SAT references and the anytime CP-SAT records;
# solver logs, records set aside as measured under CPU contention, and the
# DANIEL base solutions stay out.
or_solution/*
!or_solution/PPVC/
or_solution/PPVC/*.log
or_solution/PPVC/anytime/*.contended.jsonl

# trained_network: the PPVC checkpoints (smoke tests and DANIEL base models out)
trained_network/*
!trained_network/PPVC/
!trained_network/PPVC/*.pth
trained_network/PPVC/*smoke*

# tables regenerated by make_paper_macros.py / make_supplement_tables.py
paper_tables/

# ---- local scratch / backups ----
_interrupted_run_backup/
.auto-git-sync.log
/IEEE

# ---- LaTeX build output ----
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz

# ---- OS / editor ----
.DS_Store
*.swp
.vscode/

# ---- not distributed ----
IEEE Paper/
experiments/
external/
video/
train_time.txt

# ---- result files behind the paper's tables (re-included) ----
!test_results/PPVC/
!test_results/PPVC/**/*.npy
test_results/PPVC/**/no_evidence_backup/
test_results/PPVC/**/old_policy_backup/
test_results/PPVC/**/contended_*/
!train_log/PPVC/
!train_log/quiet_cost.status
!train_log/quiet_cost_gpu_samples.csv
!train_log/train_10x15+ppvc-mixed+fthalf-tight-s301.log
!train_log/train_10x25+ppvc-mixed+fthalf-lag15-s301.log
